# ============================================================
# AI Messenger — Environment Variables
# ============================================================
# Copy this to .env.local and fill in your values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Meta / Facebook ---
NEXT_PUBLIC_META_APP_ID=1234567890
META_APP_SECRET=your-app-secret-here
META_VERIFY_TOKEN=hermes_ai_messenger_verify_2024

# --- OpenRouter (AI) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# --- Lemon Squeezy (Payments) ---
LEMON_SQUEEZY_API_KEY=your-lemon-squeezy-api-key
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-secret
# New plan variants:
LEMON_SQUEEZY_VARIANT_STARTER=your-variant-id
LEMON_SQUEEZY_VARIANT_STARTER_ANNUAL=your-variant-id
LEMON_SQUEEZY_VARIANT_PRO=your-variant-id
LEMON_SQUEEZY_VARIANT_PRO_ANNUAL=your-variant-id
# Backward compat (keep until migrated):
LEMON_SQUEEZY_VARIANT_2W=your-variant-id
LEMON_SQUEEZY_VARIANT_4W=your-variant-id
LEMON_SQUEEZY_VARIANT_12W=your-variant-id

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback
INTERNAL_API_SECRET=change-this-to-a-random-string
